
# Fail, never skip: a tool that did not land is a broken install (core § 1).
# Check TOOLS_BIN itself, not `command -v`: a runner's preinstalled, unpinned
# copy of the same tool on PATH would otherwise hide a failed install.
missing=""
for t in $REQUIRED; do
    [ -x "$TOOLS_BIN/$t" ] || missing="$missing $t"
done
if [ -n "$missing" ]; then
    echo "ERROR: install-tools.sh did not install:$missing" >&2
    exit 1
fi
echo "install-tools: ok ($REQUIRED)"
