
# --- shell slice: shfmt, shellcheck and bats-core, each verified before install ---
v=$(pin shfmt)
f=$(fetch "https://github.com/mvdan/sh/releases/download/v$v/shfmt_v${v}_linux_$GOARCH" "shfmt-$ARCH")
put "$f" shfmt
v=$(pin shellcheck)
f=$(fetch "https://github.com/koalaman/shellcheck/releases/download/v$v/shellcheck-v$v.linux.$ARCH.tar.xz" "shellcheck-$ARCH")
tar -xJf "$f" -C "$TMP"
put "$TMP/shellcheck-v$v/shellcheck" shellcheck
v=$(pin bats)
f=$(fetch "https://github.com/bats-core/bats-core/archive/refs/tags/v$v.tar.gz" "bats-any")
tar -xzf "$f" -C "$TMP"
"$TMP/bats-core-$v/install.sh" "$(dirname "$TOOLS_BIN")" >/dev/null
REQUIRED="$REQUIRED shellcheck shfmt bats"
