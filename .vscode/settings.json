{
  // Editor settings
  "editor.formatOnSave": true,

  // Use dprint as the formatter for JSON/YAML (matches CI). Markdown is
  // handled by the rumdl CLI on commit.
  "[json]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[yaml]": {
    "editor.defaultFormatter": "dprint.dprint",
    // dprint excludes .devcontainer/**, so on save it declines compose files
    // and the editor falls back to its own indentation. Pin 2-space and stop
    // auto-detecting (the existing 4-space file would otherwise self-perpetuate).
    "editor.tabSize": 2,
    "editor.detectIndentation": false
  }
}
